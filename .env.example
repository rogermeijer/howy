APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cc
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon (started by `composer dev`) works the redis queues.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gmail mailboxes — see docs/gmail.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/settings/mailboxes/gmail/callback"
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE="${APP_URL}/webhooks/gmail"
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# Optional: reserved ngrok domain — when set, `composer dev` also runs ngrok and Vite allows that origin
# so you can use cc.test and the tunnel URL side by side (see docs/gmail.md).
NGROK_DOMAIN=
NGROK_PORT=8000

# Knowledge base (docs/plan-kennisbank.md). Queue workers and php-fpm often run
# with a narrower PATH than your shell: point these at the tools if they are
# not found, e.g. /opt/homebrew/bin/pdftohtml on Apple Silicon.
KNOWLEDGE_DISK=knowledge
KNOWLEDGE_QUEUE=knowledge
# KNOWLEDGE_PDFTOHTML=pdftohtml
# KNOWLEDGE_PDFINFO=pdfinfo
# KNOWLEDGE_PDFTOPPM=pdftoppm
# KNOWLEDGE_QPDF=qpdf
# KNOWLEDGE_PANDOC=pandoc

# AI for the knowledge base: embeddings and the LLM steps run on OpenAI.
# Without a key, documents are still extracted and searchable by text.
OPENAI_API_KEY=
